<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.workspace-memory.refresh</string>
  <key>ProgramArguments</key><array><string>@PYTHON@</string><string>@WSM@</string><string>refresh</string><string>--quiet</string></array>
  <key>StartInterval</key><integer>@INTERVAL@</integer>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>EnvironmentVariables</key><dict><key>CASS_RAW_MIRROR</key><string>@RAW_MIRROR@</string><key>WSM_CASS</key><string>@CASS@</string></dict>
  <key>StandardOutPath</key><string>@STATE@/refresh.log</string>
  <key>StandardErrorPath</key><string>@STATE@/refresh.log</string>
</dict></plist>
